# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres123@postgres:5432/leadhunter?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=leadhunter
POSTGRES_PORT=5432

# Redis & Filas BullMQ
REDIS_URL="redis://redis:6379"
REDIS_HOST=redis
REDIS_PORT=6379

# Google Places API / Google Maps Platform
GOOGLE_MAPS_API_KEY=

# Portas dos Serviços
APP_PORT=3001
FRONTEND_PORT=3000
VITE_API_URL=/api

# Localização e Preferências Regionais
DEFAULT_COUNTRY=BR
DEFAULT_LANGUAGE=pt-BR
DEFAULT_TIMEZONE=America/Sao_Paulo
NODE_ENV=production
